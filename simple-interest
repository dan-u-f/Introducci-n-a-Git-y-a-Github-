#!/bin/bash

# simple-interest.sh
# A simple command-line calculator that computes simple interest
# based on user-provided input: principal, interest rate, and time.
#
# Formula: Simple Interest (SI) = (P x R x T) / 100

echo "=== Simple Interest Calculator ==="

read -p "Enter the principal amount: " principal
read -p "Enter the interest rate (in %): " rate
read -p "Enter the time period (in years): " time

# Basic validation: make sure none of the fields were left empty
if [ -z "$principal" ] || [ -z "$rate" ] || [ -z "$time" ]; then
    echo "Error: all fields (principal, rate, time) are required."
    exit 1
fi

# Calculate simple interest using bc for floating point math
simple_interest=$(echo "scale=2; ($principal * $rate * $time) / 100" | bc)

echo "-----------------------------------"
echo "Principal Amount : $principal"
echo "Interest Rate    : $rate%"
echo "Time Period      : $time year(s)"
echo "Simple Interest  : $simple_interest"
echo "-----------------------------------"
